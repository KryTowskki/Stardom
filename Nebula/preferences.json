[
  {
    "type": "text",
    "label": "🌎 General Settings",
    "margin": "30px 0 30px 0",
    "size": "20px"
  },
    {
      "type": "separator",
      "label": "🔭 Tab Animations",
      "margin": "15px 0 15px 0"
    },
      {
        "type": "dropdown",
        "property": "nebula-tab-switch-animation",
        "label": "Tab Switch Animation",
        "value": "number",
        "defaultValue": 1,
        "placeholder": false,
        "options": [
          { "label": "No Animation", "value": 0 },
          { "label": "Default", "value": 1 },
          { "label": "Bounce Smooth", "value": 2 }
        ]
      },
    {
      "type": "separator",
      "label": "🛸 Glow Effects",
      "margin": "15px 0 15px 0"
    },
      {
        "type": "dropdown",
        "property": "nebula-glow-gradient",
        "label": "Hover Glow Animations",
        "value": "number",
        "defaultValue": 1,
        "placeholder": false,
        "options": [
          { "label": "None", "value": 0 },
          { "label": "Zen Color", "value": 1 },
          { "label": "Monochrome", "value": 2 },
          { "label": "RGB", "value": 3 }
        ]
      },
    {
      "type": "separator",
      "label": "☄️ Workspace Buttons",
      "margin": "15px 0 15px 0"
    },
      {
        "type": "dropdown",
        "property": "nebula-workspace-style",
        "label": "Workspace Button Style",
        "value": "number",
        "defaultValue": 1,
        "placeholder": false,
        "options": [
          { "label": "No background", "value": 0 },
          { "label": "Default", "value": 1 }
        ]
      },
    {
      "type": "separator",
      "label": "🌟 Audio Buttons",
      "margin": "15px 0 15px 0"
    },
      {
        "type": "dropdown",
        "property": "nebula-default-sound-style",
        "label": "Audio Button Style",
        "value": "number",
        "defaultValue": 1,
        "placeholder": false,
        "options": [
          { "label": "Disable", "value": 0 },
          { "label": "Default", "value": 1 },
          { "label": "Floating", "value": 2 }
        ]
      },
    {
      "type": "separator",
      "label": "🚥 Window Control Buttons",
      "margin": "15px 0 15px 0"
    },
      {
        "type": "checkbox",
        "property": "zen.view.experimental-force-window-controls-left",
        "label": "Force window controls to left side (Restart)"
      },

{
  "type": "separator",
  "label": "",
  "margin": "15px 0 15px 0"
},

{
  "type": "text",
  "label": "🌙 Config Options",
  "margin": "15px 0 30px 0",
  "size": "20px"
},
  {
    "type": "checkbox",
    "property": "nebula-pinned-tabs-bg",
    "label": "Disable background on pinned tabs",
    "margin": "12px 0"
  },
  {
    "type": "checkbox",
    "property": "nebula-turn-off-zen-menu-icon",
    "label": "Disable the Zen icon from menu button",
    "margin": "12px 0"
  },
  {
    "type": "checkbox",
    "property": "nebula-disable-menu-animations",
    "label": "Disable the Context Menu Animations",
    "margin": "12px 0"
  },
  {
    "type": "checkbox",
    "property": "nebula-essentials-gray-icons",
    "label": "Enable gray out essentials icons when idle",
    "margin": "12px 0"
  },
  {
    "type": "checkbox",
    "property": "nebula-folder-styling",
    "label": "Enable Zen Folders styling",
    "margin": "12px 0"
  },

{
  "type": "separator",
  "label": "",
  "margin": "15px 0 15px 0"
},

{
  "type": "text",
  "label": "🪐 Config Variables",
  "margin": "15px 0 30px 0",
  "size": "20px"
},
  {
    "type": "separator",
    "label": "✨ Glass &  Blur Effects",
    "margin": "15px 0 15px 0"
  },
    {
      "type": "string",
      "property": "var-nebula-glass-blur",
      "label": "Nebula Glass Blur",
      "defaultValue": "32px",
      "placeholder": "e.g. 32px"
    },
    {
      "type": "string",
      "property": "var-nebula-glass-saturation",
      "label": "Nebula Glass Saturation",
      "defaultValue": "140%",
      "placeholder": "e.g. 140%"
    },
    {
      "type": "string",
      "property": "var-nebula-color-glass-light",
      "label": "Nebula Glass Color (light)",
      "defaultValue": "rgba(255, 255, 255, 0.4)",
      "placeholder": "rgba(255, 255, 255, 0.4)"
    },
    {
      "type": "string",
      "property": "var-nebula-color-glass-dark",
      "label": "Nebula Glass Color (dark)",
      "defaultValue": "rgba(0, 0, 0, 0.4)",
      "placeholder": "rgba(0, 0, 0, 0.4)"
    },
  {
    "type": "separator",
    "label": "🌌 UI &  Website Tint",
    "margin": "15px 0 15px 0"
  },
    {
      "type": "string",
      "property": "var-nebula-ui-tint-light",
      "label": "UI Tint (light)",
      "defaultValue": "rgba(255,255,255,0.2)",
      "placeholder": "rgba(255,255,255,0.2)"
    },
    {
      "type": "string",
      "property": "var-nebula-ui-tint-dark",
      "label": "UI Tint (dark)",
      "defaultValue": "rgba(0,0,0,0.2)",
      "placeholder": "rgba(0,0,0,0.2)"
    },
    {
      "type": "string",
      "property": "var-nebula-website-tint-light",
      "label": "Website Tint (light)",
      "defaultValue": "rgba(255,255,255,0)",
      "placeholder": "rgba(255,255,255,0)"
    },
    {
      "type": "string",
      "property": "var-nebula-website-tint-dark",
      "label": "Website Tint (dark)",
      "defaultValue": "rgba(0,0,0,0)",
      "placeholder": "rgba(0,0,0,0)"
    },
  {
    "type": "separator",
    "label": "🌠 Colors",
    "margin": "15px 0 15px 0"
  },
    {
      "type": "string",
      "property": "var-nebula-tabs-minimum-light",
