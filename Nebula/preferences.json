    {
      "type": "string",
      "property": "var-nebula-tabs-minimum-dark",
      "label": "Pinned Tabs (dark)",
      "defaultValue": "rgba(0, 0, 0, 0.2)",
      "placeholder": "rgba(0, 0, 0, 0.2)"
    },
    {
      "type": "string",
      "property": "var-nebula-tabs-default-light",
      "label": "Tab Default (light)",
      "defaultValue": "rgba(255,255,255,0.25)",
      "placeholder": "rgba(255,255,255,0.25)"
    },
    {
      "type": "string",
      "property": "var-nebula-tabs-default-dark",
      "label": "Tab Default (dark)",
      "defaultValue": "rgba(0,0,0,0.35)",
      "placeholder": "rgba(0,0,0,0.35)"
    },
    {
      "type": "string",
      "property": "var-nebula-tabs-hover-light",
      "label": "Tab Hover (light)",
      "defaultValue": "rgba(255,255,255,0.35)",
      "placeholder": "rgba(255,255,255,0.35)"
    },
    {
      "type": "string",
      "property": "var-nebula-tabs-hover-dark",
      "label": "Tab Hover (dark)",
      "defaultValue": "rgba(0,0,0,0.45)",
      "placeholder": "rgba(0,0,0,0.45)"
    },
    {
      "type": "string",
      "property": "var-nebula-tabs-selected-light",
      "label": "Tab Selected (light)",
      "defaultValue": "rgba(255,255,255,0.45)",
      "placeholder": "rgba(255,255,255,0.45)"
    },
    {
      "type": "string",
      "property": "var-nebula-tabs-selected-dark",
      "label": "Tab Selected (dark)",
      "defaultValue": "rgba(0,0,0,0.55)",
      "placeholder": "rgba(0,0,0,0.55)"
    },
    {
      "type": "string",
      "property": "var-nebula-color-shadow-light",
      "label": "Color of Shadows (light)",
      "defaultValue": "rgba(255, 255, 255, 0.055)",
      "placeholder": "rgba(255, 255, 255, 0.055)"
    },
    {
      "type": "string",
      "property": "var-nebula-color-shadow-dark",
      "label": "Color of Shadows (dark)",
      "defaultValue": "rgba(0, 0, 0, 0.55)",
      "placeholder": "rgba(0, 0, 0, 0.55)"
    },
  {
    "type": "separator",
    "label": "🌙 Layout",
    "margin": "15px 0 15px 0"
  },
    {
      "type": "string",
      "property": "var-nebula-border-radius",
      "label": "Border Radius (Roundness of UI)",
      "defaultValue": "13px",
      "placeholder": "e.g. 13px"
    },
    {
      "type": "string",
      "property": "var-nebula-essentials-width",
      "label": "Essential Tabs Width",
      "defaultValue": "60px",
      "placeholder": "e.g. 60px"
    },
    {
      "type": "string",
      "property": "var-nebula-workspace-grayscale",
      "label": "Workspace Buttons Grayscale",
      "defaultValue": "100%",
      "placeholder": "e.g. 100%"
    }
]
